# Apache config for the generated Nuxt SPA on Hostinger (public_html).
# Copied into .output/public on every `pnpm generate`.

Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Serve real files and folders as-is (prerendered pages, _nuxt assets, images)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else (e.g. /sign/<token>, /drive/link/<token>) -> SPA fallback
    RewriteRule ^ 200.html [L]
</IfModule>

<IfModule mod_headers.c>
    # Hashed build assets never change: cache for a year
    <If "%{REQUEST_URI} =~ m#^/_nuxt/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # HTML must always be revalidated so new deploys show up at once
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
